# Copie este arquivo para .env e preencha os valores.

# PostgreSQL (Missão 3)
DATABASE_URL="postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/easyfood"

# JWT (Atividade 5) - use uma chave longa e aleatória
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"

# E-mail (Atividade 6) - provedor SMTP via Nodemailer (ex.: Gmail com senha de app)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="seu-email@gmail.com"
EMAIL_PASS="sua-senha-de-app"
EMAIL_FROM="seu-email@gmail.com"
EMAIL_FROM_NAME="EasyFood"

# Destinatário de teste (usado quando o restaurante não informa e-mail)
EMAIL_TEST_TO="seu-email-de-teste@gmail.com"
# Destinatário das notificações comerciais (se vazio, usa EMAIL_TEST_TO)
COMMERCIAL_EMAIL=""

PORT=3000
